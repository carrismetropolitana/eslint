  "Carris Metropolitana Context": {
    "prefix": "cmcontext",
    "body": [
      "'use client';",
      "",
      "/* * */",
      "",
      "import { ${1:ExampleType} } from '@carrismetropolitana/api-types/${2:network}';",
      "import { swrFetcher } from '@tmlmobilidade/utils';",
      "import { createContext, PropsWithChildren, useContext, useMemo } from 'react';",
      "import useSWR from 'swr';",
      "",
      "/* * */",
      "",
      "export type ${3:ExampleData} = ${1:ExampleType} & { ${4:additional_field}: ${5:string}[] };",
      "",
      "interface ${6:ExampleContextState} {",
      "\tactions: {",
      "\t\t$7",
      "\t}",
      "\tdata: {",
      "\t\t$8",
      "\t}",
      "\tfilters: {",
      "\t\t$9",
      "\t}",
      "\tflags: {",
      "\t\terror: Error | undefined",
      "\t\tisLoading: boolean",
      "\t}",
      "}",
      "",
      "/* * */",
      "",
      "const ${6:ExampleContextState}Context = createContext<${6:ExampleContextState} | undefined>(undefined);",
      "",
      "export const use${6:ExampleContextState} = () => {",
      "\tconst context = useContext(${6:ExampleContextState}Context);",
      "\tif (!context) {",
      "\t\tthrow new Error('use${6:ExampleContextState} must be used within an ${6:ExampleContextState}Provider');",
      "\t}",
      "\treturn context;",
      "};",
      "",
      "/* * */",
      "",
      "export function ${6:ExampleContextState}Provider({ children }: PropsWithChildren) {",
      "\t//",
      "",
      "\t//",
      "\t// A. Setup variables",
      "",
      "\t//",
      "\t// B. Fetch data",
      "\tconst { data: ${10:items}Data, error: ${10:items}Error, isLoading: ${10:items}Loading } = useSWR<${3:ExampleData}[], Error>(`/api${11:}`, swrFetcher);",
      "",
      "\t//",
      "\t// C. Transform Data",
      "",
      "\t//",
      "\t// D. Define actions",
      "",
      "\t//",
      "\t// E. Define context value",
      "",
      "\tconst contextValue: ${6:ExampleContextState} = useMemo(() => ({",
      "\t\tactions: {",
      "\t\t\t$12",
      "\t\t},",
      "\t\tdata: {",
      "\t\t\t${10:items}: ${10:items}Data ?? [],",
      "\t\t\t$13",
      "\t\t},",
      "\t\tfilters: {",
      "\t\t\t$14",
      "\t\t},",
      "\t\tflags: {",
      "\t\t\terror: ${10:items}Error,",
      "\t\t\tisLoading: ${10:items}Loading,",
      "\t\t},",
      "\t}), [${10:items}Data, ${10:items}Error, ${10:items}Loading]);",
      "",
      "\t//",
      "\t// F. Return context provider",
      "",
      "\treturn (",
      "\t\t<${6:ExampleContextState}Context.Provider value={contextValue}>",
      "\t\t\t{children}",
      "\t\t</${6:ExampleContextState}Context.Provider>",
      "\t);",
      "",
      "\t//",
      "};",
      "",
      "$0"
    ],
    "description": "Carris Metropolitana React Context with clean structure and A-F sections"
  }
