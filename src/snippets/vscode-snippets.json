  "Carris Metropolitana Functional Component with Example": {
    "prefix": "cmfcexample",
    "body": [
      "'use client';",
      "",
      "/* * */",
      "",
      "import { useTranslations } from 'next-intl';",
      "import useSWR from 'swr';",
      "",
      "import styles from './styles.module.css';",
      "",
      "/* * */",
      "",
      "interface Props {",
      "\t${1:testProp}?: ${2:string}",
      "}",
      "",
      "// Recommended to define the data type elsewhere",
      "interface ${3:TestDataType} {",
      "\titems: {",
      "\t\tid: string",
      "\t\tname: string",
      "\t}[]",
      "}",
      "",
      "/* * */",
      "",
      "export function ${4:ExampleComponent}({ ${1:testProp} }: Props) {",
      "\t//",
      "",
      "\t//",
      "\t// A. Setup variables",
      "",
      "\tconst t = useTranslations();",
      "",
      "\t//",
      "\t// B. Fetch data",
      "",
      "\tconst { data, error, isLoading } = useSWR<${3:TestDataType}>('${5:https://api.example.com/data}'); // recommended use of Routes file",
      "",
      "\t//",
      "\t// C. Transform data",
      "",
      "\tconst transformedData = data ? data.items.filter(item => item.name === ${1:testProp}) : [];",
      "",
      "\t//",
      "\t// D. Handle actions",
      "",
      "\tconst handleClick = () => {",
      "\t\tconsole.log('Item clicked');",
      "\t};",
      "",
      "\t//",
      "\t// E. Render components",
      "",
      "\tif (isLoading) return <p>Loading...</p>;",
      "\tif (error) return <p>Error</p>;",
      "",
      "\treturn (",
      "\t\t<div className={styles.container} onClick={handleClick}>",
      "\t\t\t<p>{t(transformedData[0]?.name)}</p>",
      "\t\t</div>",
      "\t);",
      "",
      "\t//",
      "}"
    ],
    "description": "Carris Metropolitana functional component with full example (SWR, handlers, transform)"
  },
