{
	"name": "@carrismetropolitana/eslint",
	"version": "1.0.0",
	"author": "João de Vasconcelos",
	"license": "AGPL-3.0-or-later",
	"homepage": "https://github.com/carrismetropolitana/eslint#readme",
	"bugs": {
		"url": "https://github.com/carrismetropolitana/eslint/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/carrismetropolitana/eslint.git"
	},
	"keywords": [
		"public transit",
		"eslint",
		"lint"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "npm run clean && tsc && resolve-tspaths",
		"clean": "rm -rf dist",
		"docs": "npm run docs:generate",
		"docs:generate": "npm run build && echo 'console.log(\"test\");' > temp-test.js && npx eslint --print-config temp-test.js > eslint-effective-config.json && rm -f temp-test.js && node analyze-rules.js && echo '✅ Comprehensive documentation updated successfully!'",
		"docs:clean": "rm -f eslint-effective-config.json linting-rules-analysis.md && echo '🧹 Documentation files cleaned!'",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@eslint/compat": "1.3.0",
		"@eslint/js": "9.29.0",
		"@humanwhocodes/momoa": "3.3.8",
		"@next/eslint-plugin-next": "15.3.4",
		"@stylistic/eslint-plugin": "4.4.1",
		"@types/eslint": "9.6.1",
		"@types/node": "24.0.3",
		"eslint": "9.29.0",
		"eslint-plugin-jsonc": "2.20.1",
		"eslint-plugin-perfectionist": "4.15.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"globals": "16.2.0",
		"postcss": "8.5.6",
		"stylelint": "16.21.0",
		"stylelint-config-recess-order": "7.1.0",
		"stylelint-config-standard": "38.0.0",
		"typescript": "5.8.3",
		"typescript-eslint": "8.34.1"
	},
	"devDependencies": {
		"@tmlmobilidade/tsconfig": "20250619.107.10",
		"@types/node": "24.0.3",
		"resolve-tspaths": "0.8.23",
		"tsx": "4.20.3",
		"typescript": "5.8.3"
	}
}
